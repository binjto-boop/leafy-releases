{
    "identifier": "com.leafy.popclip.lookup",
    "popclipVersion": 6159,
    "name": "Leafy",
    "icon": "icon.png",
    "description": "Look up, translate, save, or make an Anki card from the selected text with Leafy.",
    "keywords": "vocabulary dictionary define definition translate translation anki flashcards save words language learning reading",
    "app": {
        "name": "Leafy",
        "link": "https://leafyapp.uk",
        "bundleIdentifiers": [
            "com.Leafy"
        ],
        "checkInstalled": true
    },
    "actions": [
        {
            "title": "Define",
            "icon": "symbol:character.book.closed.fill",
            "javascript": "popclip.openUrl('leafy://lookup?mode=define&text=' + encodeURIComponent(popclip.input.text) + '&app=' + encodeURIComponent(popclip.context.appName || ''), { activate: false });",
            "requirements": [
                "text",
                "!url",
                "!email"
            ]
        },
        {
            "title": "Translate",
            "icon": "symbol:globe",
            "javascript": "popclip.openUrl('leafy://lookup?mode=translate&text=' + encodeURIComponent(popclip.input.text) + '&app=' + encodeURIComponent(popclip.context.appName || ''), { activate: false });",
            "requirements": [
                "text",
                "!url",
                "!email"
            ]
        },
        {
            "title": "Save",
            "icon": "symbol:bookmark.fill",
            "javascript": "popclip.openUrl('leafy://lookup?mode=save&text=' + encodeURIComponent(popclip.input.text) + '&app=' + encodeURIComponent(popclip.context.appName || ''), { activate: false }); popclip.showSuccess();",
            "requirements": [
                "text",
                "!url",
                "!email"
            ]
        },
        {
            "title": "Add to Anki",
            "icon": "symbol:rectangle.stack.badge.plus",
            "javascript": "popclip.openUrl('leafy://lookup?mode=anki&text=' + encodeURIComponent(popclip.input.text) + '&app=' + encodeURIComponent(popclip.context.appName || ''), { activate: false }); popclip.showSuccess();",
            "requirements": [
                "text",
                "!url",
                "!email"
            ]
        }
    ]
}
